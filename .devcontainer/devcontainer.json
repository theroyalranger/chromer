{
"name": "The Royal Chromer",
"image": "mcr.microsoft.com/devcontainers/universal:2",
"containerEnv": {
"CHROME_CLI": "file:///defaults/index.html --homepage file:///defaults/index.html --allow-file-access-from-files --disable-web-security"
},
"postStartCommand": "cp ${containerWorkspaceFolder}/index.html /defaults/index.html",
"customizations": {
"vscode": {
"extensions": [
"ms-azuretools.vscode-docker"
]
}
},
"forwardPorts": [8080]
}
