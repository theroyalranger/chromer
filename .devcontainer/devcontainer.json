{
"name": "Selkies Chrome Performance Optimized",
"image": "lscr.io/linuxserver/chrome:latest",
"overrideCommand": false,
"containerEnv": {
"CHROME_CLI": "file:///defaults/index.html --homepage file:///defaults/index.html --ignore-gpu-blocklist --enable-gpu-rasterization --enable-zero-copy --num-raster-threads=4 --disable-smooth-scrolling --disable-background-networking --disable-component-update --disable-ipc-flooding-protection --enable-features=ParallelDownloading,CanvasOopRasterization"
},
"postStartCommand": "cp ${containerWorkspaceFolder}/index.html /defaults/index.html",
"forwardPorts": [3000],
"portsAttributes": {
"3000": {
"label": "The Royal Chromer",
"onAutoForward": "notify"
}
}
}
