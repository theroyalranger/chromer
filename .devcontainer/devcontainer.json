{
"name": "The Royal Chromer",
"image": "mcr.microsoft.com/devcontainers/universal:2",
"remoteUser": "codespace",
"hostRequirements": {
"cpus": 4,
"memory": "16gb"
},
"forwardPorts": [3000, 8080],
"portsAttributes": {
"3000": {
"label": "Start Page Server",
"onAutoForward": "notify"
},
"8080": {
"label": "The Royal Chromer Desktop",
"onAutoForward": "openBrowser"
}
},
"containerEnv": {
"CHROME_CLI": "--homepage file:///defaults/index.html --force-device-scale-factor=1 --high-dpi-support=1 --ignore-gpu-blocklist --enable-webgl --enable-webgl2-compute-context --use-gl=swiftshader --enable-unsafe-swiftshader --disable-gpu-sandbox --enable-zero-copy --num-raster-threads=4 --disable-smooth-scrolling --disable-background-networking --disable-component-update --enable-features=ParallelDownloading,CSSContainerQueries,LayoutNG --disable-features=IsolateOrigins,site-per-process --disable-web-security"
},
"postCreateCommand": "sudo apt-get update && sudo apt-get install -y google-chrome-stable || true && sudo mkdir -p /defaults /etc/opt/chrome/policies/managed && sudo ln -sf "${containerWorkspaceFolder}/index.html" /defaults/index.html && sudo sh -c 'echo "{\"HomepageLocation\":\"file:///defaults/index.html\",\"NewTabPageLocation\":\"file:///defaults/index.html\"}" > /etc/opt/chrome/policies/managed/custom_start_page.json'",
"postStartCommand": "python3 -m http.server 3000 --directory ${containerWorkspaceFolder} &",
"customizations": {
"vscode": {
"settings": {
"editor.formatOnSave": true
},
"extensions": [
"formulahendry.auto-close-tag",
"formulahendry.auto-rename-tag"
]
}
}
}
