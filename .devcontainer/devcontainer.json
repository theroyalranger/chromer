{
"name": "The Royal Chromer Dev Container",
"image": "mcr.microsoft.com/devcontainers/universal:2",
"customizations": {
"vscode": {
"settings": {
"terminal.integrated.profiles.linux": {
"bash": {
"path": "bash",
"icon": "terminal-bash"
}
}
},
"extensions": [
"ms-azuretools.vscode-docker"
]
}
},
"forwardPorts": [3000],
"portsAttributes": {
"3000": {
"label": "Application Port",
"onAutoForward": "notify",
"elevateIfNeeded": true
}
},
"postCreateCommand": "echo 'Dev container initialized successfully.'",
"runArgs": [
"--init"
],
"containerEnv": {
"CHROME_FLAGS": "--remote-debugging-port=9222 --no-sandbox --allow-file-access-from-files"
}
}
