{
"name": "The Royal Chromer Dev Container",
"image": "mcr.microsoft.com/devcontainers/base:ubuntu",
"forwardPorts": [3000],
"portsAttributes": {
"3000": {
"label": "Web Preview / Server",
"onAutoForward": "openPreview"
}
},
"postStartCommand": "nohup python3 -m http.server 3000 > /dev/null 2>&1 &",
"customizations": {
"vscode": {
"settings": {
"terminal.integrated.defaultProfile.linux": "bash"
},
"extensions": [
"ms-azuretools.vscode-docker"
]
}
},
"containerEnv": {
"PORT": "3000",
"CHROME_FLAGS": "--allow-file-access-from-files --disable-web-security"
},
"remoteUser": "vscode"
}
